{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apt-at-home-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "account_id": "12412d5b061683494ea3e5c217d6a961",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "apt"
    }
  ],
  "observability": {
    "enabled": true
  }
}
