{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apt-at-home-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "account_id": "12412d5b061683494ea3e5c217d6a961",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "AUTH_REQUIRED": "false"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "apt"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "apt_at_home_events"
    }
  ],
  "analytics": {
    "binding": "ANALYTICS_SQL"
  },
  "ratelimits": [
    {
      "name": "INDEX_LIMITER",
      "namespace_id": "100101",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "DOWNLOAD_LIMITER",
      "namespace_id": "100102",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "PACKAGE_LIMITER",
      "namespace_id": "100103",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "build": {
    "command": "bun run build:web"
  },
  "observability": {
    "enabled": true
  }
}
