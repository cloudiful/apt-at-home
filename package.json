{
  "name": "apt-at-home-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authenticated Cloudflare Worker gateway for a private Debian APT repository",
  "scripts": {
    "build:web": "vite build --config web/vite.config.ts",
    "pretypecheck": "bun run build:web",
    "typecheck": "tsc --noEmit",
    "pretest": "bun run build:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run test",
    "check:py": "uv run python -m unittest discover -s tests",
    "check:all": "bun run typecheck && bun run test && uv run python -m unittest discover -s tests",
    "worker:dry-run": "bun run build:web && wrangler deploy --config worker/wrangler.jsonc --dry-run --outdir dist/worker"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261010.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
